{
  "manifest_version": 3,
  "name": "ClipShot 滚动长截图",
  "version": "0.3.0",
  "description": "整页滚动长截图 / 可视区域 / 元素 / 框选截图,基于 chrome.debugger。自用扩展。",
  "minimum_chrome_version": "126",
  "permissions": [
    "debugger",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "downloads",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/sw.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ClipShot 滚动长截图",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "MacCtrl+Shift+F" },
      "description": "整页长截图"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V", "mac": "MacCtrl+Shift+V" },
      "description": "可视区域截图"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S" },
      "description": "框选区域截图"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P" },
      "description": "打开 ClipShot 面板"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.chrome-extension.com/*"],
      "js": ["common/messages.js", "common/geom.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
